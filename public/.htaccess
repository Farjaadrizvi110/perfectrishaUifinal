Options -MultiViews
RewriteEngine On

# Force UTF-8
AddDefaultCharset UTF-8

# ── 1. MOST IMPORTANT: Let Alt-Node mounted paths PASS THROUGH Apache untouched. ──
#    This rule MUST be BEFORE any 301 redirect, trailing-slash rule, or SPA catch-all.
#    When the request starts with any known Node mount prefix, skip ALL remaining rules.
RewriteCond %{REQUEST_URI} ^/perfectrishtabackend(/|$) [OR]
RewriteCond %{REQUEST_URI} ^/perfectrishta-backend(/|$) [OR]
RewriteCond %{REQUEST_URI} ^/perfectrishtaback-end(/|$) [OR]
RewriteCond %{REQUEST_URI} ^/node-api-internal(/|$) [OR]
RewriteCond %{REQUEST_URI} ^/node-api-internal-v2(/|$)
RewriteRule ^ - [L]

# ── 2. Trailing-slash-to-no-slash redirect ──
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# ── 3. Real existing files/directories serve verbatim ──
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ── 4. SPA fallback: everything else -> index.html ──
RewriteRule ^ index.html [L]

# -------------------------------------------------------------------
# Cache Strategy
# -------------------------------------------------------------------
# index.html -> NEVER cache (we want the newest entry point always)
<FilesMatch "^index\.html$">
  FileETag None
  Header unset ETag
  Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

# Content-hashed Vite assets: 1 year immutable
# Matches: assets/something-{5 to 16 hex/alpha chars}.ext
<FilesMatch "^assets\/.+\-[A-Za-z0-9]{5,16}\.(css|js|png|jpg|jpeg|gif|svg|webp|avif|woff|woff2|ttf|eot|ico|mp4|webm)$">
  FileETag None
  Header unset ETag
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Static images folder (not content-hashed): 7 days
<FilesMatch "\.(png|jpg|jpeg|gif|svg|webp|avif|ico)$">
  Header set Cache-Control "public, max-age=604800, must-revalidate"
</FilesMatch>

# Fonts: 1 year
<FilesMatch "\.(woff|woff2|ttf|eot|otf)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# -------------------------------------------------------------------
# Compression (mod_deflate)
# -------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/manifest+json
  AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
  AddOutputFilterByType DEFLATE application/x-font-ttf
  AddOutputFilterByType DEFLATE font/opentype
  AddOutputFilterByType DEFLATE font/woff font/woff2
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE image/x-icon
</IfModule>

# -------------------------------------------------------------------
# Baseline Security Headers (non-intrusive, AdSense-safe)
# -------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
